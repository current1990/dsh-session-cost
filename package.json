{
  "name": "dsh-session-cost",
  "version": "0.1.0",
  "description": "Real-time session cost meter for the DeepSeek Harness (CNY): token usage from the session log and the live stream, priced by an editable per-model table.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cost",
    "token-meter"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=20"
  }
}
